# SignalGate environment - copy to .env (gitignored) and fill ONLY for LIVE mode.
# Repro / judges / CI need ZERO keys: LOCAL_MOCK mode is the default.

# mock | live  (auto-falls back to mock when live creds are missing; banner shown)
SIGNALGATE_MODE=mock

# LIVE mode only: any OpenAI-compatible endpoint (portability row, doc 03 §9).
# Primary routed ID (Bedrock Nova, ap-south-1) is verified by scripts/routing_ritual.py.
SIGNALGATE_MODEL=
SIGNALGATE_API_BASE=
SIGNALGATE_API_KEY=

# Per-run spend breaker, USD (doc 03 §10)
SIGNALGATE_SPEND_CAP_USD=2.00

# Deterministic dataset / probe seed (locked with docs; do not change casually)
SIGNALGATE_SEED=20260828
